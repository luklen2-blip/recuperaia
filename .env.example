# Ambiente e Configurações Gerais
NODE_ENV=development
PORT=3000
APP_NAME=RecuperaIA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de Dados PostgreSQL Multi-tenant (Prisma ORM)
# Compatível com PostgreSQL local, Supabase, Neon, Railway ou Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recuperaia?schema=public"

# Segurança & Autenticação Multi-tenant
JWT_SECRET="recuperaia-ultra-secure-jwt-secret-key-production-2026"
ENCRYPTION_KEY="recuperaia-aes256-encryption-key-for-credentials"

# Integração OpenAI (Geração Inteligente de Cópia e Recuperação de Vendas)
# Se ausente, o sistema ativa automaticamente o Fallback de Regras Estáticas claramente demarcado
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Integração WhatsApp Business Platform (Meta Cloud API Oficial)
# Se ausente, o sistema ativa automaticamente o WhatsApp Sandbox Simulator claramente demarcado
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="recuperaia_meta_verify_token_2026"

# Integração Mercado Pago & Pagamentos PIX Oficial BACEN
# Se ausente, opera em modo Sandbox com geração EMV Copia-e-Cola válida para testes
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
PIX_KEY="financeiro@recuperaia.com.br"
PIX_BENEFICIARY_NAME="RecuperaIA Tecnologia Ltda"
PIX_CITY="SAO PAULO"
